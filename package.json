{
  "name": "contract-repayment",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": "^24.21.0",
    "npm": "^11.19.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "test:web": "npm run test --workspace apps/web",
    "check:web": "npm run build:web && npm run test:web",
    "test:browser": "node scripts/test-web-browser.cjs",
    "start": "npm run start --workspace apps/api",
    "build": "npm run build --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:unit --workspace apps/api",
    "test:e2e": "npm run test:e2e --workspace apps/api",
    "test:cov": "npm run test:cov --workspace apps/api",
    "test:cov:all": "node scripts/test-integration.cjs --coverage",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test:cov:all",
    "test:integration": "node scripts/test-integration.cjs",
    "test:performance": "node scripts/performance.cjs",
    "prisma:generate": "npm run prisma:generate --workspace apps/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace apps/api --",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace apps/api",
    "db:migrate:status": "npm run db:migrate:status --workspace apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
